# =============================================================================
# ULSS 9 Chatbot Backend - Enterprise Configuration
# European Government Deployment (EU AI Act + GDPR compliant)
# =============================================================================

# ── Required ──────────────────────────────────────
GEMINI_API_KEY="your-gemini-api-key-here"
JWT_SECRET="change-me-in-production"          # 32+ byte random
WIDGET_SECRET="change-me-widget-secret"       # 32+ byte random — signs public session tokens

# Admin: seeded in database on first run (change via password reset)
ADMIN_SEED_EMAIL="admin@aulss9.veneto.it"
ADMIN_SEED_PASSWORD="ChangeMe@FirstLogin!"
# ── AI / Gemini ────────────────────────────────────
MODEL="gemini-2.5-flash"
STORE_PREFIX="ulss9"
# ALLOW_ENGLISH="true"

# ── Application ────────────────────────────────────
APP_ENV="production"
ENVIRONMENT="production"                       # "production" disables /docs, /redoc, debug endpoints
DEBUG="false"
LOG_LEVEL="INFO"
LOG_FORMAT="json"                              # "json" for production, "text" for dev

# ── Database (PostgreSQL recommended) ─────────────
DATABASE_URL="postgresql://ulss9:secure-password@localhost:5432/ulss9_chatbot"
# Dev/testing fallback:
# DATABASE_URL="sqlite:///./data/ulss9.db"

# ── Security ───────────────────────────────────────
ALLOWED_ORIGINS="https://www.aulss9.veneto.it,https://aulss9.veneto.it"
CORS_ALLOW_CREDENTIALS="true"
TRUST_PROXY="true"
SESSION_TOKEN_TTL="3600"                       # seconds

# GDPR: salt for IP hashing in audit logs
IP_HASH_SALT="change-me-random-salt"

# ── Rate Limiting ──────────────────────────────────
RATE_LIMIT_CHAT="10/minute"                    # per IP on /api/chat
RATE_LIMIT_DEFAULT="60/minute"                 # per IP default
RATE_LIMIT_REQUESTS="60"                       # legacy: requests per window
RATE_LIMIT_WINDOW_SECONDS="60"                 # legacy: window in seconds

# ── Redis (optional) ──────────────────────────────
# REDIS_URL="redis://localhost:6379"            # For distributed rate limits + OTP storage

# ── Email / Password Reset (Brevo) ────────────────
EMAIL_PROVIDER="brevo"
EMAIL_FROM="noreply@aulss9.veneto.it"
EMAIL_FROM_NAME="ULSS 9 Scaligera Admin"
BREVO_API_KEY="xkeysib-..."                    # Brevo (Sendinblue) transactional API key
OTP_TTL_SECONDS="600"                          # 10 minutes
OTP_MAX_ATTEMPTS="3"

# ── Chat Logging (GDPR) ──────────────────────────
LOG_RETENTION_DAYS="30"                        # Auto-purge chat logs after N days
CHAT_LOG_ANONYMISE="true"                      # Hash IPs in chat logs

# ── Audit (GDPR compliance) ───────────────────────
AUDIT_LOG_ENABLED="true"
AUDIT_LOG_PATH="/app/logs/audit.jsonl"
AUDIT_RETENTION_DAYS="365"

# ── Server ─────────────────────────────────────────
HOST="0.0.0.0"
PORT="8000"
WORKERS="1"
SHUTDOWN_TIMEOUT="30"

# ── Health Checks ──────────────────────────────────
HEALTH_CHECK_PATH="/health"
READINESS_CHECK_PATH="/ready"
